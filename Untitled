│ │ Phase 2: Database Schema (30 mins)                                                                                                          │ │
│ │                                                                                                                                             │ │
│ │ -- portfolios table                                                                                                                         │ │
│ │ CREATE TABLE portfolios (                                                                                                                   │ │
│ │   id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),                                                                                           │ │
│ │   user_id UUID REFERENCES auth.users, -- for future auth                                                                                    │ │
│ │   symbol TEXT NOT NULL,                                                                                                                     │ │
│ │   name TEXT,                                                                                                                                │ │
│ │   type TEXT NOT NULL, -- STOCK, MF, ETF, CASH                                                                                               │ │
│ │   account TEXT NOT NULL,                                                                                                                    │ │
│ │   sector TEXT,                                                                                                                              │ │
│ │   created_at TIMESTAMPTZ DEFAULT NOW(),                                                                                                     │ │
│ │   updated_at TIMESTAMPTZ DEFAULT NOW()                                                                                                      │ │
│ │ );                                                                                                                                          │ │
│ │                                                                                                                                             │ │
│ │ -- transactions table                                                                                                                       │ │
│ │ CREATE TABLE transactions (                                                                                                                 │ │
│ │   id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),                                                                                           │ │
│ │   portfolio_id UUID REFERENCES portfolios ON DELETE CASCADE,                                                                                │ │
│ │   price DECIMAL NOT NULL,                                                                                                                   │ │
│ │   quantity DECIMAL NOT NULL,                                                                                                                │ │
│ │   date DATE NOT NULL,                                                                                                                       │ │
│ │   created_at TIMESTAMPTZ DEFAULT NOW()                                                                                                      │ │
│ │ );                                                                                                                                          │ │
│ │                                                                                                                                             │ │
│ │ -- dividends table                                                                                                                          │ │
│ │ CREATE TABLE dividends (                                                                                                                    │ │
│ │   id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),                                                                                           │ │
│ │   portfolio_id UUID REFERENCES portfolios ON DELETE CASCADE,                                                                                │ │
│ │   amount DECIMAL NOT NULL,                                                                                                                  │ │
│ │   date DATE NOT NULL,                                                                                                                       │ │
│ │   created_at TIMESTAMPTZ DEFAULT NOW()                                                                                                      │ │
│ │ );                                                                                                                                          │ │
│ │                                                                                                                                             │ │
│ │ -- user_preferences table                                                                                                                   │ │
│ │ CREATE TABLE user_preferences (                                                                                                             │ │
│ │   id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),                                                                                           │ │
│ │   user_id UUID UNIQUE REFERENCES auth.users,                                                                                                │ │
│ │   accounts JSONB DEFAULT '[]',                                                                                                              │ │
│ │   market_prices JSONB DEFAULT '{}',                                                                                                         │ │
│ │   selected_view TEXT DEFAULT 'ALL',                                                                                                         │ │
│ │   expanded_groups JSONB DEFAULT '[]',                                                                                                       │ │
│ │   updated_at TIMESTAMPTZ DEFAULT NOW()                                                                                                      │ │
│ │ );                                                                                                                                          │ │
│ │                                                                                                                                             │ │
