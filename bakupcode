import React, { useState, useEffect, useMemo, useRef } from 'react';
import {
    PieChart, Pie, Cell, Legend, Tooltip, ResponsiveContainer
} from 'recharts';
import {
    Search, Plus, Trash2, TrendingUp, TrendingDown,
    Wallet, PieChart as PieIcon, Activity, RefreshCw,
    ChevronRight, ArrowUpRight, ArrowDownRight, Briefcase,
    Sparkles, MessageSquare, X, Info, ShieldAlert, Zap, Clock, CheckCircle2,
    Layers, FolderPlus, Edit3, Save, Filter, Check, Calendar, History,
    Download, Upload, Settings, AlertCircle
} from 'lucide-react';

const APP_ID = 'bharat-invest-tracker-pro-v5';
const COLORS = ['#6366f1', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'];

const App = () => {
    // --- State ---
    const [portfolio, setPortfolio] = useState(() => {
        const saved = localStorage.getItem(`${APP_ID}_portfolio`);
        return saved ? JSON.parse(saved) : [];
    });
    const [accounts, setAccounts] = useState(() => {
        const saved = localStorage.getItem(`${APP_ID}_accounts`);
        return saved ? JSON.parse(saved) : ['Primary Wallet', 'Brokerage'];
    });

    const [activeAccounts, setActiveAccounts] = useState(accounts);
    const [activeTypes, setActiveTypes] = useState(['STOCK', 'MF']);
    const [marketPrices, setMarketPrices] = useState(() => {
        const saved = localStorage.getItem(`${APP_ID}_market_prices`);
        return saved ? JSON.parse(saved) : {};
    });
    const [isRefreshing, setIsRefreshing] = useState(false);
    const [showAddModal, setShowAddModal] = useState(false);
    const [showSettingsModal, setShowSettingsModal] = useState(false);

    // Wallet Management UI state
    const [isAddingWallet, setIsAddingWallet] = useState(false);
    const [newWalletName, setNewWalletName] = useState('');
    const [walletToDelete, setWalletToDelete] = useState(null);

    // Inline Edit Price state
    const [editingId, setEditingId] = useState(null);
    const [editValue, setEditValue] = useState('');

    const [searchQuery, setSearchQuery] = useState('');
    const [buyPrice, setBuyPrice] = useState('');
    const [quantity, setQuantity] = useState('');
    const [buyDate, setBuyDate] = useState(new Date().toISOString().split('T')[0]);
    const [selectedAccount, setSelectedAccount] = useState(accounts[0] || '');
    const [addStatus, setAddStatus] = useState('idle');

    const fileInputRef = useRef(null);

    // --- Persistence ---
    useEffect(() => {
        localStorage.setItem(`${APP_ID}_portfolio`, JSON.stringify(portfolio));
        localStorage.setItem(`${APP_ID}_accounts`, JSON.stringify(accounts));
        localStorage.setItem(`${APP_ID}_market_prices`, JSON.stringify(marketPrices));
    }, [portfolio, accounts, marketPrices]);

    // Validates selected account if the list changes
    useEffect(() => {
        if (accounts.length > 0 && !accounts.includes(selectedAccount)) {
            setSelectedAccount(accounts[0]);
        }
    }, [accounts, selectedAccount]);

    // --- Wallet Actions ---
    const handleConfirmAddWallet = () => {
        const name = newWalletName.trim();
        if (name && !accounts.includes(name)) {
            const updated = [...accounts, name];
            setAccounts(updated);
            setActiveAccounts([...activeAccounts, name]);
            setNewWalletName('');
            setIsAddingWallet(false);
        }
    };

    const handleConfirmDeleteWallet = () => {
        if (!walletToDelete) return;
        const updatedAccounts = accounts.filter(a => a !== walletToDelete);
        setAccounts(updatedAccounts);
        setPortfolio(portfolio.filter(p => p.account !== walletToDelete));
        setActiveAccounts(activeAccounts.filter(a => a !== walletToDelete));
        setWalletToDelete(null);
    };

    // --- Market Engine ---
    const getMarketData = async (symbol, type) => {
        try {
            if (type === 'MF') {
                const res = await fetch(`https://api.mfapi.in/mf/${symbol}`);
                const data = await res.json();
                const nav = parseFloat(data.data[0].nav);
                const prevNav = data.data[1] ? parseFloat(data.data[1].nav) : nav;
                return { price: nav, change: nav - prevNav, changePercent: prevNav !== 0 ? ((nav - prevNav) / prevNav) * 100 : 0 };
            } else {
                const ticker = symbol.includes('.') ? symbol : `${symbol}.NS`;
                const proxyUrl = `https://api.allorigins.win/get?url=${encodeURIComponent(`https://query1.finance.yahoo.com/v8/finance/chart/${ticker}?interval=1m&range=1d`)}`;
                const response = await fetch(proxyUrl);
                const json = await response.json();
                const yahooData = JSON.parse(json.contents);
                if (yahooData?.chart?.result?.[0]) {
                    const meta = yahooData.chart.result[0].meta;
                    return {
                        price: meta.regularMarketPrice,
                        change: meta.regularMarketPrice - meta.chartPreviousClose,
                        changePercent: meta.chartPreviousClose !== 0 ? ((meta.regularMarketPrice - meta.chartPreviousClose) / meta.chartPreviousClose) * 100 : 0
                    };
                }
                return null;
            }
        } catch (e) { return null; }
    };

    const refreshPrices = async () => {
        if (portfolio.length === 0) return;
        setIsRefreshing(true);
        const symbols = [...new Set(portfolio.map(p => ({ symbol: p.symbol, type: p.type })))];
        const results = await Promise.all(symbols.map(async (s) => {
            const data = await getMarketData(s.symbol, s.type);
            return { symbol: s.symbol, data };
        }));
        setMarketPrices(prev => {
            const next = { ...prev };
            results.forEach(r => { if (r.data) next[r.symbol] = r.data; });
            return next;
        });
        setIsRefreshing(false);
    };

    const handleManualPriceUpdate = (symbol) => {
        const val = parseFloat(editValue);
        if (isNaN(val)) return;
        setMarketPrices(prev => ({
            ...prev,
            [symbol]: { ...(prev[symbol] || {}), price: val, manual: true }
        }));
        setEditingId(null);
    };

    // --- Logic ---
    const processedPortfolio = useMemo(() => {
        return portfolio.map(asset => {
            const totalQty = asset.transactions.reduce((s, t) => s + t.quantity, 0);
            const totalCost = asset.transactions.reduce((s, t) => s + (t.quantity * t.price), 0);
            const avgPrice = totalQty > 0 ? totalCost / totalQty : 0;
            const mData = marketPrices[asset.symbol] || { price: avgPrice, change: 0, changePercent: 0 };
            const currentValue = totalQty * mData.price;
            const absReturn = currentValue - totalCost;
            const absReturnPercent = totalCost > 0 ? (absReturn / totalCost) * 100 : 0;
            const oldestDate = new Date(Math.min(...asset.transactions.map(t => new Date(t.date))));
            const years = Math.max(0.01, (new Date() - oldestDate) / 31557600000);
            const isAnn = years >= 0.5;
            const perf = isAnn ? (Math.pow((currentValue / totalCost), (1 / years)) - 1) * 100 : ((currentValue - totalCost) / totalCost) * 100;
            return { ...asset, totalQty, avgPrice, currentPrice: mData.price, dayChange: (mData.change || 0) * totalQty, dayChangePercent: mData.changePercent || 0, currentValue, investedValue: totalCost, absReturn, absReturnPercent, performanceVal: perf, isAnnualized: isAnn };
        });
    }, [portfolio, marketPrices]);

    const filteredPortfolio = useMemo(() => {
        return processedPortfolio.filter(p => activeAccounts.includes(p.account) && activeTypes.includes(p.type));
    }, [processedPortfolio, activeAccounts, activeTypes]);

    const stats = useMemo(() => {
        const invested = filteredPortfolio.reduce((s, p) => s + p.investedValue, 0);
        const current = filteredPortfolio.reduce((s, p) => s + p.currentValue, 0);
        const dayChange = filteredPortfolio.reduce((s, p) => s + p.dayChange, 0);
        const absReturn = current - invested;
        const absReturnPct = invested > 0 ? (absReturn / invested) * 100 : 0;
        const dayChangePct = (current - dayChange) > 0 ? (dayChange / (current - dayChange)) * 100 : 0;
        return { invested, current, absReturn, absReturnPct, dayChange, dayChangePct };
    }, [filteredPortfolio]);

    const formatCurrency = (val) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(val || 0);

    const handleAddAsset = async () => {
        if (!searchQuery || !buyPrice || !quantity) return;
        setAddStatus('loading');
        const symbol = searchQuery.toUpperCase().trim();
        const type = /^\d+$/.test(symbol) ? 'MF' : 'STOCK';
        const newTransaction = { price: parseFloat(buyPrice), quantity: parseFloat(quantity), date: buyDate, id: Date.now() };
        setPortfolio(prev => {
            const idx = prev.findIndex(p => p.symbol === symbol && p.account === selectedAccount);
            if (idx > -1) {
                const updated = [...prev];
                updated[idx].transactions.push(newTransaction);
                return updated;
            } else {
                return [...prev, { id: `${symbol}_${selectedAccount}_${Date.now()}`, symbol, name: symbol, type, account: selectedAccount, transactions: [newTransaction] }];
            }
        });
        setAddStatus('success');
        setTimeout(() => { setShowAddModal(false); setAddStatus('idle'); setSearchQuery(''); setBuyPrice(''); setQuantity(''); }, 800);
    };

    return (
        <div className="min-h-screen bg-slate-50 text-slate-900 pb-24 font-sans">
            <header className="bg-white border-b border-slate-200 sticky top-0 z-30 px-6 py-4 flex items-center justify-between shadow-sm">
                <div className="flex items-center gap-3">
                    <div className="bg-indigo-600 p-2.5 rounded-2xl text-white shadow-lg"><Activity size={24} /></div>
                    <h1 className="text-xl font-black text-slate-800 tracking-tight">BharatInvest Pro</h1>
                </div>
                <div className="flex gap-2">
                    <button onClick={() => setShowSettingsModal(true)} className="p-2.5 rounded-xl bg-slate-50 border text-slate-600 hover:bg-indigo-50 transition-all"><Settings size={20} /></button>
                    <button onClick={refreshPrices} className={`p-2.5 rounded-xl bg-slate-50 border hover:bg-slate-100 transition-all ${isRefreshing ? 'animate-spin text-indigo-600' : ''}`}><RefreshCw size={20} /></button>
                </div>
            </header>

            <main className="max-w-6xl mx-auto p-4 md:p-8 space-y-8">
                {/* Dashboard Highlights */}
                <section className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="bg-white p-6 rounded-[2rem] border shadow-sm relative overflow-hidden group">
                        <Wallet size={80} className="absolute -top-4 -right-4 opacity-5 group-hover:scale-110 transition-transform text-indigo-600" />
                        <p className="text-slate-500 text-[10px] font-black uppercase tracking-widest">Total Portfolio</p>
                        <h2 className="text-4xl font-black mt-2 text-slate-800 tabular-nums">{formatCurrency(stats.current)}</h2>
                        <div className={`mt-4 inline-flex items-center text-xs font-bold px-3 py-1 rounded-full ${stats.absReturn >= 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}`}>
                            {stats.absReturnPct.toFixed(2)}% Total P&L
                        </div>
                    </div>
                    <div className="bg-white p-6 rounded-[2rem] border shadow-sm">
                        <p className="text-slate-500 text-[10px] font-black uppercase tracking-widest">Today's Movement</p>
                        <h2 className={`text-3xl font-black mt-2 tabular-nums ${stats.dayChange >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                            {stats.dayChange >= 0 ? '+' : ''}{formatCurrency(stats.dayChange)}
                        </h2>
                        <p className="text-[10px] text-slate-400 font-bold uppercase mt-2 tracking-widest">{stats.dayChangePct.toFixed(2)}% Change Today</p>
                    </div>
                    <div className="bg-indigo-600 p-6 rounded-[2rem] text-white shadow-xl shadow-indigo-100 flex flex-col justify-between">
                        <div className="flex justify-between items-start">
                            <p className="text-indigo-200 text-[10px] font-black uppercase">Tracking Logic</p>
                            <Zap size={20} className="text-amber-300" />
                        </div>
                        <h3 className="text-xl font-bold mt-4 tracking-tight">Active Wallets: {accounts.length}</h3>
                        <p className="text-indigo-200 text-[10px] font-medium mt-1 uppercase">LTP Overrides available in table</p>
                    </div>
                </section>

                {/* --- WALLET & CATEGORY MANAGEMENT --- */}
                <section className="bg-white p-6 rounded-3xl border shadow-sm space-y-8">
                    <div className="space-y-6">
                        <div className="flex items-center justify-between border-b pb-4 border-slate-100">
                            <div className="space-y-1">
                                <h3 className="font-bold text-sm flex items-center gap-2 text-slate-800 uppercase tracking-widest"><Filter size={14} className="text-indigo-600" /> Portfolio Wallets</h3>
                                <p className="text-[9px] text-slate-400 font-bold uppercase">Toggle to filter view • Manage assets by wallet</p>
                            </div>

                            {!isAddingWallet ? (
                                <button
                                    onClick={() => setIsAddingWallet(true)}
                                    className="px-4 py-2 bg-indigo-50 text-indigo-600 rounded-xl hover:bg-indigo-100 transition-all border border-indigo-100 flex items-center gap-2 text-[10px] font-black uppercase"
                                >
                                    <FolderPlus size={16} /> New Wallet
                                </button>
                            ) : (
                                <div className="flex items-center gap-2 animate-in slide-in-from-right-4">
                                    <input
                                        autoFocus
                                        type="text"
                                        placeholder="Wallet Name..."
                                        className="px-3 py-2 bg-slate-50 border border-indigo-200 rounded-xl text-xs font-bold outline-none"
                                        value={newWalletName}
                                        onChange={(e) => setNewWalletName(e.target.value)}
                                        onKeyDown={(e) => e.key === 'Enter' && handleConfirmAddWallet()}
                                    />
                                    <button onClick={handleConfirmAddWallet} className="p-2 bg-indigo-600 text-white rounded-xl"><Check size={16}/></button>
                                    <button onClick={() => setIsAddingWallet(false)} className="p-2 bg-slate-100 text-slate-400 rounded-xl"><X size={16}/></button>
                                </div>
                            )}
                        </div>

                        <div className="flex flex-wrap gap-3">
                            {accounts.map(acc => (
                                <div
                                    key={acc}
                                    onClick={() => setActiveAccounts(p => p.includes(acc) ? p.filter(x=>x!==acc) : [...p, acc])}
                                    className={`group relative flex items-center gap-3 px-5 py-3 rounded-2xl text-xs font-bold border transition-all cursor-pointer ${
                                        activeAccounts.includes(acc)
                                        ? 'bg-indigo-600 text-white border-indigo-600 shadow-lg shadow-indigo-100'
                                        : 'bg-white text-slate-500 border-slate-200 hover:border-indigo-300'
                                    }`}
                                >
                                    <Wallet size={14} className={activeAccounts.includes(acc) ? 'text-indigo-200' : 'text-slate-300'} />
                                    <span>{acc}</span>
                                    <button
                                        onClick={(e) => { e.stopPropagation(); setWalletToDelete(acc); }}
                                        className={`p-1 rounded-lg hover:bg-black/20 transition-all opacity-0 group-hover:opacity-100 ${
                                            activeAccounts.includes(acc) ? 'text-white/60' : 'text-rose-400'
                                        } ${accounts.length <= 1 ? 'hidden' : ''}`}
                                    >
                                        <Trash2 size={12} />
                                    </button>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div className="space-y-4 pt-2 border-t border-slate-50">
                        <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest">Asset Category Filter</p>
                        <div className="flex gap-2">
                            {[
                                { id: 'STOCK', label: 'Equities' },
                                { id: 'MF', label: 'Mutual Funds' }
                            ].map(type => (
                                <button
                                    key={type.id}
                                    onClick={() => setActiveTypes(p => p.includes(type.id) ? p.filter(x=>x!==type.id) : [...p, type.id])}
                                    className={`flex-1 py-2.5 rounded-xl text-xs font-bold border transition-all ${
                                        activeTypes.includes(type.id)
                                        ? 'bg-slate-800 text-white border-slate-800 shadow-md'
                                        : 'bg-white text-slate-500 border-slate-200 hover:border-indigo-300'
                                    }`}
                                >
                                    {type.label}
                                </button>
                            ))}
                        </div>
                    </div>
                </section>

                {/* Holdings Table */}
                <section className="bg-white rounded-[2.5rem] border shadow-sm overflow-hidden">
                    <div className="p-8 border-b flex items-center justify-between bg-slate-50/50">
                        <h3 className="font-black text-xl text-slate-800 tracking-tight">Active Holdings</h3>
                        <button onClick={() => setShowAddModal(true)} className="bg-indigo-600 text-white px-6 py-3 rounded-2xl font-black text-sm shadow-xl hover:bg-indigo-700 transition-all flex items-center gap-2">
                            <Plus size={18} /> Add Entry
                        </button>
                    </div>
                    <div className="overflow-x-auto">
                        <table className="w-full text-left">
                            <thead className="bg-slate-50 text-slate-400 text-[10px] uppercase font-black tracking-widest">
                                <tr>
                                    <th className="px-8 py-5">Asset Detail</th>
                                    <th className="px-6 py-5 text-right">Avg / Qty</th>
                                    <th className="px-6 py-5 text-right">LTP (Click to Edit)</th>
                                    <th className="px-6 py-5 text-right">Total Gain</th>
                                    <th className="px-8 py-5 text-center">Manage</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-slate-100 text-sm">
                                {filteredPortfolio.length === 0 ? (
                                    <tr><td colSpan="5" className="px-8 py-16 text-center text-slate-400 italic">No assets found for these filters.</td></tr>
                                ) : (
                                    filteredPortfolio.map((item) => (
                                        <tr key={item.id} className="hover:bg-slate-50/50 group transition-colors">
                                            <td className="px-8 py-6">
                                                <div className="font-black text-slate-800 uppercase tracking-tight">{item.symbol}</div>
                                                <div className="text-[9px] text-slate-400 font-bold uppercase">{item.account}</div>
                                            </td>
                                            <td className="px-6 py-6 text-right tabular-nums">
                                                <div className="font-bold text-slate-600">{item.totalQty} Units</div>
                                                <div className="text-[10px] text-slate-400 font-bold">₹{item.avgPrice.toFixed(2)} Avg</div>
                                            </td>
                                            <td className="px-6 py-6 text-right tabular-nums">
                                                {editingId === item.id ? (
                                                    <div className="flex items-center justify-end gap-2">
                                                        <input
                                                            autoFocus
                                                            type="number"
                                                            className="w-24 px-2 py-1 bg-white border border-indigo-300 rounded-lg text-right text-xs outline-none"
                                                            value={editValue}
                                                            onChange={(e) => setEditValue(e.target.value)}
                                                            onKeyDown={(e) => e.key === 'Enter' && handleManualPriceUpdate(item.symbol)}
                                                        />
                                                        <button onClick={() => handleManualPriceUpdate(item.symbol)} className="text-indigo-600"><Save size={16}/></button>
                                                    </div>
                                                ) : (
                                                    <div
                                                        className="cursor-pointer hover:bg-indigo-50 p-1 rounded-lg transition-colors inline-block group/price"
                                                        onClick={() => { setEditingId(item.id); setEditValue(item.currentPrice); }}
                                                    >
                                                        <div className="font-black text-slate-800 flex items-center gap-1 justify-end">
                                                            ₹{item.currentPrice?.toFixed(2)}
                                                            <Edit3 size={10} className="text-slate-300 opacity-0 group-hover/price:opacity-100 transition-opacity" />
                                                        </div>
                                                        <div className={`text-[10px] font-black ${item.dayChangePercent >= 0 ? 'text-emerald-500' : 'text-rose-500'}`}>
                                                            {item.dayChangePercent >= 0 ? '+' : ''}{item.dayChangePercent.toFixed(2)}%
                                                        </div>
                                                    </div>
                                                )}
                                            </td>
                                            <td className="px-6 py-6 text-right tabular-nums">
                                                <div className={`font-black ${item.absReturn >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                                                    {formatCurrency(item.absReturn)}
                                                </div>
                                                <div className="text-[10px] text-slate-400 font-bold uppercase">
                                                    {item.performanceVal.toFixed(1)}% {item.isAnnualized ? 'CAGR' : 'Abs'}
                                                </div>
                                            </td>
                                            <td className="px-8 py-6 text-center">
                                                <button onClick={() => setPortfolio(p => p.filter(x=>x.id !== item.id))} className="p-2 text-slate-300 hover:text-rose-500 transition-colors">
                                                    <Trash2 size={16}/>
                                                </button>
                                            </td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>

            {/* Wallet Delete Confirmation Modal */}
            {walletToDelete && (
                <div className="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in">
                    <div className="bg-white w-full max-sm:w-full max-w-sm rounded-[2rem] p-8 shadow-2xl space-y-6">
                        <div className="w-16 h-16 bg-rose-50 text-rose-500 rounded-3xl flex items-center justify-center mx-auto">
                            <ShieldAlert size={32} />
                        </div>
                        <div className="text-center space-y-2">
                            <h2 className="text-xl font-black text-slate-800">Delete Wallet?</h2>
                            <p className="text-sm text-slate-500">Are you sure you want to delete <span className="font-bold">"{walletToDelete}"</span>? All associated investments will be lost.</p>
                        </div>
                        <div className="flex gap-3">
                            <button onClick={() => setWalletToDelete(null)} className="flex-1 py-3.5 bg-slate-100 text-slate-600 rounded-2xl font-bold text-sm">Cancel</button>
                            <button onClick={handleConfirmDeleteWallet} className="flex-1 py-3.5 bg-rose-600 text-white rounded-2xl font-bold text-sm shadow-lg shadow-rose-100">Delete All</button>
                        </div>
                    </div>
                </div>
            )}

            {/* Add Transaction Modal */}
            {showAddModal && (
                <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md animate-in fade-in">
                    <div className="bg-white w-full max-w-md rounded-[3rem] shadow-2xl overflow-hidden">
                        <div className="p-8 border-b bg-slate-50 flex justify-between items-center"><h2 className="text-2xl font-black text-slate-800">Add Transaction</h2><button onClick={()=>setShowAddModal(false)}><X size={24}/></button></div>
                        <div className="p-8 space-y-5">
                            <div className="space-y-1">
                                <label className="text-[10px] font-black text-slate-400 uppercase ml-1">Select Wallet</label>
                                <select className="w-full px-5 py-3.5 bg-slate-50 rounded-2xl font-bold outline-none border border-transparent focus:border-indigo-200 appearance-none" value={selectedAccount} onChange={e=>setSelectedAccount(e.target.value)}>{accounts.map(acc => <option key={acc} value={acc}>{acc}</option>)}</select>
                            </div>
                            <div className="space-y-1">
                                <label className="text-[10px] font-black text-slate-400 uppercase ml-1">Asset Symbol</label>
                                <input type="text" placeholder="TCS, RELIANCE..." className="w-full px-5 py-3.5 bg-slate-50 rounded-2xl outline-none font-bold uppercase" value={searchQuery} onChange={e=>setSearchQuery(e.target.value)} />
                            </div>
                            <div className="grid grid-cols-2 gap-4">
                                <div className="space-y-1">
                                    <label className="text-[10px] font-black text-slate-400 uppercase ml-1">Quantity</label>
                                    <input type="number" placeholder="0" className="w-full px-5 py-3.5 bg-slate-50 rounded-2xl outline-none font-bold" value={quantity} onChange={e=>setQuantity(e.target.value)} />
                                </div>
                                <div className="space-y-1">
                                    <label className="text-[10px] font-black text-slate-400 uppercase ml-1">Buy Price (₹)</label>
                                    <input type="number" placeholder="0" className="w-full px-5 py-3.5 bg-slate-50 rounded-2xl outline-none font-bold" value={buyPrice} onChange={e=>setBuyPrice(e.target.value)} />
                                </div>
                            </div>
                            <button onClick={handleAddAsset} disabled={addStatus==='loading'} className={`w-full py-4 rounded-[1.5rem] font-black text-white shadow-xl transition-all flex items-center justify-center gap-2 ${addStatus==='success' ? 'bg-emerald-500' : 'bg-indigo-600 hover:bg-indigo-700'}`}>
                                {addStatus==='loading' ? <RefreshCw className="animate-spin" size={20}/> : <Plus size={20}/>} {addStatus==='success' ? 'Saved Asset' : 'Add to Portfolio'}
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
};

export default App;







